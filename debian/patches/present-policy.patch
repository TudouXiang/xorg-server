+static Bool
+policy_crtc_valid(PresentPolicyWindow handle, PresentPolicyCrtc crtc)
+{
+    WindowPtr window = handle;
+    return window && crtc && RRCrtcExists(window->drawable.pScreen, crtc);
+}
+
+static void *
+policy_screen(PresentPolicyWindow handle, PresentPolicyCrtc crtc)
+{
+    WindowPtr window = handle;
+    RRCrtcPtr native_crtc = crtc;
+    if (!window)
+        return NULL;
+    if (!crtc)
+        return window->drawable.pScreen;
+    return policy_crtc_valid(window, crtc) ? native_crtc->pScreen : NULL;
+}
+
+static uint32_t
+policy_crtc_id(PresentPolicyWindow window, PresentPolicyCrtc crtc)
+{
+    RRCrtcPtr native_crtc = crtc;
+    return policy_crtc_valid(window, crtc) ? (uint32_t) native_crtc->id : 0;
+}
+
+static Bool
+policy_window_name(PresentPolicyWindow handle, char *buffer, uint32_t size)
+{
+    WindowPtr current = handle;
+    if (!current || size < 2)
+        return FALSE;
+    for (; current; current = current->parent) {
+        PropertyPtr property;
+        for (property = wUserProps(current); property; property = property->next) {
+            size_t length;
+            if (property->propertyName != XA_WM_NAME ||
+                property->type != XA_STRING || property->format != 8 ||
+                !property->data)
+                continue;
+            length = property->size;
+            if (length >= size)
+                length = size - 1;
+            memcpy(buffer, property->data, length);
+            buffer[length] = '\0';
+            return TRUE;
+        }
+    }
+    return FALSE;
+}
+
+static void *
+policy_window_data(PresentPolicyWindow handle)
+{
+    WindowPtr window = handle;
+    return window ? dixLookupPrivate(&window->devPrivates, &policy_window_key) : NULL;
+}
+
+const PresentPolicyHooksV3 *present_policy_hooks;
+static const void *present_policy_provider;
+static Bool present_policy_stopping;
+Bool present_policy_ready;
+static const PresentPolicyHostV3 present_policy_host = {
+    PRESENT_POLICY_ABI_V3, sizeof(PresentPolicyHostV3),
+    present_policy_view, present_policy_get_data, present_policy_set_data, present_policy_visit,
+    present_policy_retain, present_policy_finish_copy, present_policy_supersede,
+    present_policy_clock, policy_screen, policy_crtc_valid, policy_crtc_id,
+    policy_window_name, policy_window_data
+};
+
+const PresentPolicyHostV3 *
+present_policy_register_v3(const void *provider, const PresentPolicyHooksV3 *hooks)
+{
+    if (!provider || !hooks || !present_policy_ready || present_policy_provider || present_policy_stopping ||
+        hooks->abi_version != PRESENT_POLICY_ABI_V3 ||
+        hooks->struct_size != sizeof(PresentPolicyHooksV3) ||
+        !hooks->destroying || !hooks->shutdown ||
+        !hooks->window_data_size || hooks->window_data_size > 4096)
+        return NULL;
+    if (policy_window_key.initialized &&
+        policy_window_key.size != (int) hooks->window_data_size)
+        return NULL;
+    if (!dixRegisterPrivateKey(&policy_window_key, PRIVATE_WINDOW, hooks->window_data_size))
+        return NULL;
+    present_policy_provider = provider;
+    present_policy_hooks = hooks;
+    return &present_policy_host;
+}
+
+void
+present_policy_unregister_v3(const void *provider)
+{
+    if (!provider || provider != present_policy_provider || present_policy_stopping)
+        return;
+    present_policy_stopping = TRUE;
+    /* Module cancels its timers and drains retained requests while its
+     * destroying callback and the host operations are still available. */
+    present_policy_hooks->shutdown();
+    present_policy_hooks = NULL;
+    present_policy_provider = NULL;
+    present_policy_stopping = FALSE;
+}
+
+void
+present_policy_reset(void)
+{
+    present_policy_unregister_v3(present_policy_provider);
+}
 
