+static Bool
+present_execute_queue_vblank(present_vblank_ptr vblank, uint64_t crtc_msc)
+{
+    WindowPtr window = vblank->window;
+    ScreenPtr screen = window->drawable.pScreen;
+    present_screen_priv_ptr screen_priv = present_screen_priv(screen);
+    Bool target = FALSE;
+    uint64_t queue_msc;
+
+    /* Neither queue path can target the next MSC in this case. */
+    if (vblank->exec_msc != crtc_msc + 1 &&
+        (!vblank->crtc || vblank->target_msc != crtc_msc + 1))
+        return FALSE;
+
+    if (present_policy_hooks && present_policy_hooks->queue_target)
+        target = present_policy_hooks->queue_target(window, vblank->crtc,
+                                                     vblank->target_msc, crtc_msc);
+
+    /* A policy may request the target MSC only for a real CRTC. Without one,
+     * preserve the existing fake-vblank scheduling path.
+     */
+    if (target && vblank->crtc)
+        queue_msc = vblank->target_msc;
+    else
+        queue_msc = vblank->exec_msc;
+
+    if (queue_msc != crtc_msc + 1)
+        return FALSE;
+
+    return screen_priv->queue_vblank(screen, window, vblank->crtc,
+                                     vblank->event_id, queue_msc) == Success;
+}
