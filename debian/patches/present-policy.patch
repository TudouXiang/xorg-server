diff --git a/present/present_policy_abi.h b/present/present_policy_abi.h
--- /dev/null
+++ b/present/present_policy_abi.h
@@ -0,0 +1,71 @@
+/* Internal contract, independently declared by host and module.
+ * No Xorg SDK/private types or installed policy SDK are required.
+ * All calls run synchronously on the server thread. Handles are borrowed;
+ * request handles become invalid after destroying or a CONSUMED result.
+ */
+#ifndef PRESENT_POLICY_ABI_H
+#define PRESENT_POLICY_ABI_H
+#include <stdint.h>
+#define PRESENT_POLICY_ABI_V3 3
+
+typedef void *PresentPolicyWindow;
+typedef void *PresentPolicyCrtc;
+typedef struct present_policy_request PresentPolicyRequest;
+typedef enum {
+    PRESENT_POLICY_NATIVE,
+    PRESENT_POLICY_RETAINED,
+    PRESENT_POLICY_CONSUMED
+} PresentPolicyResult;
+typedef struct {
+    PresentPolicyWindow window;
+    PresentPolicyCrtc crtc;
+    uint64_t target_msc, current_msc;
+    int clock_valid, pixmap, full, ready, sized, immediate;
+    void *data; /* Submit-stack cookie; never retain its address. */
+} PresentPolicySubmit;
+typedef struct {
+    PresentPolicyWindow window;
+    PresentPolicyCrtc crtc;
+    uint64_t target_msc, exec_msc, event_id;
+    int pixmap, full, ready, sized, flip, queued, live_crtc;
+    void *data;
+} PresentPolicyView;
+typedef struct present_policy_host_v3 {
+    uint32_t abi_version, struct_size;
+    void (*view)(PresentPolicyRequest *, PresentPolicyView *);
+    void *(*get_data)(PresentPolicyRequest *);
+    void (*set_data)(PresentPolicyRequest *, void *);
+    /* Read-only traversal; no request/resource mutations in the visitor. */
+    void (*visit)(PresentPolicyWindow, void (*)(PresentPolicyRequest *, void *), void *);
+    int (*retain)(PresentPolicyRequest *, uint64_t);
+    /* Success consumes the handle through native Copy/Idle/Complete/cleanup. */
+    int (*finish_copy)(PresentPolicyRequest *, uint64_t, uint64_t);
+    /* True consumes newer when keep_carrier, otherwise consumes pending. */
+    int (*supersede)(PresentPolicyRequest *, PresentPolicyRequest *, int,
+                      uint64_t, uint64_t);
+    void (*clock)(PresentPolicyRequest *, uint64_t *, uint64_t *);
+    void *(*screen)(PresentPolicyWindow, PresentPolicyCrtc);
+    int (*crtc_valid)(PresentPolicyWindow, PresentPolicyCrtc);
+    uint32_t (*crtc_id)(PresentPolicyWindow, PresentPolicyCrtc);
+    int (*window_name)(PresentPolicyWindow, char *, uint32_t);
+    /* Host-owned zeroed POD storage, sized by hooks->window_data_size. */
+    void *(*window_data)(PresentPolicyWindow);
+} PresentPolicyHostV3;
+typedef struct present_policy_hooks_v3 {
+    uint32_t abi_version, struct_size, window_data_size;
+    int (*force_copy)(PresentPolicyWindow);
+    int (*queue_target)(PresentPolicyWindow, PresentPolicyCrtc, uint64_t, uint64_t);
+    int (*driver_first)(PresentPolicyWindow, PresentPolicyCrtc);
+    void (*before_submit)(PresentPolicySubmit *);
+    PresentPolicyResult (*created)(PresentPolicyRequest *, const PresentPolicySubmit *, uint64_t);
+    PresentPolicyResult (*execute)(PresentPolicyRequest *, uint64_t, uint64_t);
+    PresentPolicyResult (*copy)(PresentPolicyRequest *, uint64_t);
+    int (*retained)(PresentPolicyRequest *);
+    void (*destroying)(PresentPolicyRequest *);
+    /* Drain retained requests/cancel timers before host clears callbacks. */
+    void (*shutdown)(void);
+    /* Request-owned malloc arrays; allocate before commit, preserve on OOM. */
+    void (*modifiers)(PresentPolicyWindow, uint32_t, uint8_t, uint8_t,
+                       uint32_t *, uint64_t **, uint32_t *, uint64_t **);
+} PresentPolicyHooksV3;
+#endif
