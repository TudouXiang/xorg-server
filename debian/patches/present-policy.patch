+/* Opaque native operations. Only these functions write native request resources. */
+#define POLICY_REQUEST(r) ((present_vblank_ptr) (r))
+void
+present_policy_view(PresentPolicyRequest *request, PresentPolicyView *view)
+{
+    present_vblank_ptr v = POLICY_REQUEST(request);
+    *view = (PresentPolicyView) {
+        v->window, v->crtc, v->target_msc, v->exec_msc, v->event_id,
+        v->pixmap != NULL, !v->valid && !v->update && !v->x_off && !v->y_off,
+        !v->wait_fence || present_fence_check_triggered(v->wait_fence),
+        v->pixmap && v->pixmap->drawable.width == v->window->drawable.width &&
+                     v->pixmap->drawable.height == v->window->drawable.height,
+        v->flip, v->queued, v->crtc && RRCrtcExists(v->screen, v->crtc), v->policy_data
+    };
+}
+
+void *present_policy_get_data(PresentPolicyRequest *r) { return POLICY_REQUEST(r)->policy_data; }
+
+void present_policy_set_data(PresentPolicyRequest *r, void *data) { POLICY_REQUEST(r)->policy_data = data; }
+
+void
+present_policy_visit(PresentPolicyWindow handle, void (*visit)(PresentPolicyRequest *, void *), void *data)
+{
+    WindowPtr window = handle;
+    present_window_priv_ptr priv = present_get_window_priv(window, FALSE);
+    present_vblank_ptr v;
+    if (priv)
+        xorg_list_for_each_entry(v, &priv->vblank, window_list)
+            visit((PresentPolicyRequest *) v, data);
+}
+
+void
+present_policy_abort_native(present_vblank_ptr v)
+{
+    Bool queued = v->queued;
+    xorg_list_del(&v->event_queue);
+    v->queued = FALSE;
+    if (v->crtc && !RRCrtcExists(v->screen, v->crtc))
+        v->crtc = NULL;
+    if (queued && v->crtc)
+        present_screen_priv(v->screen)->abort_vblank(v->screen, v->window, v->crtc,
+                                                    v->event_id, v->target_msc);
+}
+
+void
+present_policy_clock(PresentPolicyRequest *request, uint64_t *ust, uint64_t *msc)
+{
+    present_vblank_ptr v = POLICY_REQUEST(request);
+    uint64_t live_ust, live_msc;
+    *ust = GetTimeInMicros();
+    if (v->crtc && RRCrtcExists(v->screen, v->crtc) &&
+        present_get_ust_msc(v->screen, v->crtc, &live_ust, &live_msc) == Success) {
+        *ust = live_ust;
+        *msc = live_msc;
+    }
+}
+
+Bool
+present_policy_retain(PresentPolicyRequest *request, uint64_t target)
+{
+    present_vblank_ptr v = POLICY_REQUEST(request);
+    uint64_t old_target = v->target_msc, old_exec = v->exec_msc;
+    if (!v->pixmap || v->flip || v->wait_fence || v->valid || v->update ||
+        v->x_off || v->y_off || v->pixmap->drawable.width != v->window->drawable.width ||
+        v->pixmap->drawable.height != v->window->drawable.height || !v->crtc ||
+        !RRCrtcExists(v->screen, v->crtc) || v->queued)
+        return FALSE;
+    v->target_msc = v->exec_msc = target;
+    if (present_screen_priv(v->screen)->queue_vblank(v->screen, v->window, v->crtc,
+                                                    v->event_id, target) != Success) {
+        v->target_msc = old_target;
+        v->exec_msc = old_exec;
+        return FALSE;
+    }
+    v->queued = TRUE;
+    xorg_list_del(&v->event_queue);
+    xorg_list_del(&v->window_list);
+    xorg_list_append(&v->event_queue, &present_exec_queue);
+    xorg_list_append(&v->window_list, &present_get_window_priv(v->window, TRUE)->vblank);
+    return TRUE;
+}
+
+Bool
+present_policy_finish_copy(PresentPolicyRequest *request, uint64_t ust, uint64_t msc)
+{
+    present_vblank_ptr v = POLICY_REQUEST(request);
+    if (!v->pixmap || v->flip ||
+        (v->wait_fence && !present_fence_check_triggered(v->wait_fence)))
+        return FALSE;
+    present_policy_abort_native(v);
+    present_execute_copy_native(v);
+    present_execute_post(v, ust, msc);
+    return TRUE; /* request consumed */
+}
+
+Bool
+present_policy_supersede(PresentPolicyRequest *pending, PresentPolicyRequest *newer,
+                         Bool keep_carrier, uint64_t ust, uint64_t msc)
+{
+    present_vblank_ptr p = POLICY_REQUEST(pending), n = POLICY_REQUEST(newer);
+    if (p == n || !p->queued || n->queued || p->window != n->window ||
+        p->screen != n->screen || p->crtc != n->crtc || !p->crtc ||
+        !RRCrtcExists(p->screen, p->crtc) || !p->pixmap || !n->pixmap ||
+        p->kind != PresentCompleteKindPixmap || n->kind != PresentCompleteKindPixmap ||
+        p->valid || n->valid || p->update || n->update || p->wait_fence || n->wait_fence ||
+        p->x_off || p->y_off || n->x_off || n->y_off || p->flip || n->flip ||
+        p->pixmap->drawable.width != n->pixmap->drawable.width ||
+        p->pixmap->drawable.height != n->pixmap->drawable.height || n->target_msc != msc)
+        return FALSE;
+    if (keep_carrier) {
+#define SWAP(type, field) do { type saved = p->field; p->field = n->field; n->field = saved; } while (0)
+        SWAP(PixmapPtr, pixmap); SWAP(uint32_t, serial);
+        SWAP(present_fence_ptr, idle_fence); SWAP(uint64_t, msc_offset);
+        SWAP(present_notify_ptr, notifies); SWAP(int, num_notifies);
+        SWAP(Bool, has_suboptimal); SWAP(PresentFlipReason, reason);
+#undef SWAP
+        p = n;
+    } else {
+        present_policy_abort_native(p);
+    }
+    present_vblank_scrap(p);
+    present_execute_post(p, ust, msc);
+    return TRUE;
+}
+#undef POLICY_REQUEST
+
 Bool
 present_init(void)
 {
+    present_policy_reset();
     xorg_list_init(&present_exec_queue);
     xorg_list_init(&present_flip_queue);
     present_fake_queue_init();
+    present_policy_ready = TRUE;
     return TRUE;
 }
